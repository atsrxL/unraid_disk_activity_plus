#!/bin/bash
# rc.disk_activity - Start/stop disk activity + wake attribution daemons

DAEMON=/usr/local/emhttp/plugins/disk.activity/scripts/disk_activity
WAKE=/usr/local/emhttp/plugins/disk.activity/scripts/disk_wake_tracker
PIDFILE=/var/run/disk_activity.pid
INI=/var/local/emhttp/disk_activity.ini

start_activity() {
  if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    echo "disk_activity daemon already running (PID $(cat "$PIDFILE"))"
  else
    nohup "$DAEMON" >/dev/null 2>&1 &
    echo "disk_activity daemon started"
  fi
}

stop_activity() {
  if [ -f "$PIDFILE" ]; then
    local pid
    pid=$(cat "$PIDFILE")
    if kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
    fi
    rm -f "$PIDFILE"
  fi
  rm -f "$INI"
}

start() {
  start_activity
  [ -x "$WAKE" ] && "$WAKE" start
}

stop() {
  [ -x "$WAKE" ] && "$WAKE" stop
  stop_activity
}

status() {
  if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    echo "disk_activity is running (PID $(cat "$PIDFILE"))"
  else
    echo "disk_activity is not running"
  fi
  [ -x "$WAKE" ] && "$WAKE" status
}

case "$1" in
  start) start ;;
  stop) stop ;;
  restart) stop; sleep 1; start ;;
  status) status ;;
  remap) [ -x "$WAKE" ] && "$WAKE" remap ;;
  *) echo "Usage: $0 start|stop|restart|status|remap" ;;
esac
