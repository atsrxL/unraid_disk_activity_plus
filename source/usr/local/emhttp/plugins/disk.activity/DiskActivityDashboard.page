<script>
(function(){
  'use strict';
  var timer=null,request=null,stopped=false;
  function esc(t){var d=document.createElement('div');d.textContent=t==null?'':String(t);return d.innerHTML;}
  function actor(e){var c=(e.container||'').trim(),p=(e.process||'unknown').trim();return c?c+(p&&p!==c?' ('+p+')':''):p;}
  function render(data){
    var body=document.getElementById('dap-open-body'),count=document.getElementById('dap-open-count');if(!body)return;
    var files=Array.isArray(data&&data.files)?data.files:[];if(count)count.textContent=(data&&data.total!=null?data.total:files.length)+(data&&data.truncated?'+':'');
    if(data&&data.enabled===false){body.innerHTML='<p class="dap-empty">Open-file snapshots disabled</p>';return;}
    if(data&&data.stale){body.innerHTML='<p class="dap-empty">Snapshot stale — check Disk Activity Plus</p>';return;}
    if(!files.length){body.innerHTML='<p class="dap-empty">No files currently open on monitored HDD pools</p>';return;}
    body.innerHTML=files.map(function(e){return '<div class="dap-row"><div class="dap-source" title="PID '+esc(e.pid||'')+'">'+esc(actor(e))+'</div><div class="dap-path" title="'+esc(e.path||'')+'">'+esc(e.path||'-')+'<span class="dap-disk">'+esc(e.disk||e.device||'')+'</span></div></div>';}).join('');
  }
  function schedule(ms){if(!stopped){clearTimeout(timer);timer=setTimeout(poll,ms);}}
  function poll(){if(stopped)return;if(document.hidden){schedule(5000);return;}if(request)return;request=fetch('/plugins/disk.activity/include/OpenFiles.php?limit=8',{credentials:'same-origin',cache:'no-store'}).then(function(r){return r.json();}).then(render).catch(function(){var b=document.getElementById('dap-open-body');if(b)b.innerHTML='<p class="dap-empty">Unable to read open-file snapshot</p>';}).finally(function(){request=null;schedule(5000);});}
  window.addEventListener('pagehide',function(){stopped=true;clearTimeout(timer);});
  document.addEventListener('visibilitychange',function(){if(!document.hidden&&!request)schedule(0);});
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',poll);else poll();
})();
</script>
