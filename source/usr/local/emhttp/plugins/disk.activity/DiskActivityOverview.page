<script>
$(function() {
  'use strict';
  var timer = null, request = null, stopped = false;
  function esc(v) { return $('<div>').text(v == null ? '' : String(v)).html(); }
  function actor(e) {
    var c = (e.container || '').trim(), p = (e.process || 'unknown').trim();
    return c ? c + (p && p !== c ? ' (' + p + ')' : '') : p;
  }
  function schedule(ms) { if (!stopped) { clearTimeout(timer); timer = setTimeout(refresh, ms); } }
  function refresh() {
    if (stopped) return;
    if (document.hidden) { schedule(5000); return; }
    if (request) return;
    request = $.ajax({url:'/plugins/disk.activity/include/OpenFiles.php?limit=500', dataType:'json', cache:false, timeout:3000})
      .done(function(data) {
        var files = Array.isArray(data.files) ? data.files : [];
        $('#open-file-count').text(files.length + (data.truncated ? '+' : ''));
        var counts = {}, rows = '';
        files.forEach(function(e) {
          var a = actor(e); counts[a] = (counts[a] || 0) + 1;
          rows += '<tr><td>'+esc(a)+'</td><td>'+esc(e.pid||'-')+'</td><td>'+esc(e.disk||e.device||'-')+'</td><td class="wake-path" title="'+esc(e.path||'')+'">'+esc(e.path||'-')+'</td></tr>';
        });
        var top = Object.keys(counts).sort(function(a,b){return counts[b]-counts[a];})[0] || '-';
        $('#open-file-source').text(top);
        if (!rows) rows = '<tr><td colspan="4">No regular files are currently open on monitored HDD pools.</td></tr>';
        $('#open-files-table tbody').html(rows);
        var stale = !!data.stale;
        $('#open-files-status').attr('class','wake-status '+(!stale && data.enabled !== false ? 'wake-ok':'wake-warn'))
          .text(data.enabled === false ? 'Current open-file snapshots are disabled in settings.' : (stale ? 'Open-file snapshot is stale; check the wake monitor service.' : 'Live open-file snapshot · RAM only · updated every 5s'));
      })
      .always(function(){ request=null; schedule(5000); });
  }
  function stop(){ stopped=true; clearTimeout(timer); if(request) request.abort(); request=null; }
  $(window).on('pagehide.diskOpenFiles beforeunload.diskOpenFiles', stop);
  $(document).on('visibilitychange.diskOpenFiles', function(){ if(!document.hidden && !request) schedule(0); });
  refresh();
});
</script>
