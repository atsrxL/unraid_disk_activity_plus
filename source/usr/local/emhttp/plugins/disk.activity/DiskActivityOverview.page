<?PHP
/* Disk Activity Plus - settings and live open files */
$plugin = 'disk.activity';
$cfg = parse_plugin_cfg($plugin);
$cssVersion = @filemtime('/usr/local/emhttp/plugins/disk.activity/assets/wake-history.css') ?: time();
$jsVersion = @filemtime('/usr/local/emhttp/plugins/disk.activity/assets/disk-activity-plus.js') ?: time();
?>
<link type="text/css" rel="stylesheet" href="/plugins/disk.activity/assets/wake-history.css?v=<?=$cssVersion?>">
<script src="/plugins/disk.activity/assets/disk-activity-plus.js?v=<?=$jsVersion?>"></script>

<div class="wake-status wake-ok" id="open-files-status">Loading current open files…</div>
<div class="wake-cards">
  <div class="wake-card">
    <div class="wake-card-value" id="open-file-count">-</div>
    <div class="wake-card-label">Currently open files</div>
  </div>
  <div class="wake-card">
    <div class="wake-card-value wake-card-actor" id="open-file-source">-</div>
    <div class="wake-card-label">Most active source</div>
  </div>
</div>

<h3>Current open files on monitored HDD pools</h3>
<p class="wake-help">
  This is a live snapshot of regular files that currently have an open file descriptor on a monitored
  rotational disk or ZFS dataset. The snapshot is generated from <code>/proc</code> into RAM; loading this
  page does not scan the file tree.
</p>
<div class="wake-table-wrap">
<table class="tablesorter wake-table" id="open-files-table">
  <thead><tr><th>Source</th><th>PID</th><th>Disk</th><th>File</th></tr></thead>
  <tbody><tr><td colspan="4">Loading…</td></tr></tbody>
</table>
</div>

<form markdown="1" method="POST" action="/update.php" target="progressFrame">
<input type="hidden" name="#file" value="<?=$plugin?>/<?=$plugin?>.cfg">

<h3>Wake attribution</h3>
_(Track HDD wake events)_:
: <select name="wake_tracking">
  <?=mk_option($cfg['wake_tracking'] ?? 'yes', "yes", _("Yes"))?>
  <?=mk_option($cfg['wake_tracking'] ?? 'yes', "no", _("No"))?>
  </select>

_(Power-state source)_:
: <select name="wake_detector">
  <?=mk_option($cfg['wake_detector'] ?? 'auto', "auto", _("Auto: Unraid state, smartctl fallback (recommended)"))?>
  <?=mk_option($cfg['wake_detector'] ?? 'auto', "unraid", _("Unraid state only (zero disk probes)"))?>
  <?=mk_option($cfg['wake_detector'] ?? 'auto', "smartctl", _("smartctl -n standby only"))?>
  </select>

_(Power-state polling interval)_:
: <select name="wake_poll">
  <?=mk_option($cfg['wake_poll'] ?? '10', "5", _("5 seconds"))?>
  <?=mk_option($cfg['wake_poll'] ?? '10', "10", _("10 seconds (recommended)"))?>
  <?=mk_option($cfg['wake_poll'] ?? '10', "15", _("15 seconds"))?>
  <?=mk_option($cfg['wake_poll'] ?? '10', "30", _("30 seconds"))?>
  </select>

_(Verbose wake tracker log)_:
: <select name="wake_verbose">
  <?=mk_option($cfg['wake_verbose'] ?? 'no', "no", _("No"))?>
  <?=mk_option($cfg['wake_verbose'] ?? 'no', "yes", _("Yes"))?>
  </select>

<h3>Current open files</h3>
_(Maximum open-file snapshot entries)_:
: <select name="open_files_limit">
  <?=mk_option($cfg['open_files_limit'] ?? '100', "50", "50")?>
  <?=mk_option($cfg['open_files_limit'] ?? '100', "100", "100")?>
  <?=mk_option($cfg['open_files_limit'] ?? '100', "200", "200")?>
  <?=mk_option($cfg['open_files_limit'] ?? '100', "500", "500")?>
  </select>

> **History retention:** wake history is automatically limited to the most recent **60 days** and at most **5,000 events**.
>
> **Attribution confidence:** HIGH requires a fanotify access immediately before physical I/O. Direct filesystem events and uniquely correlated `/mnt/user` events may be HIGH. MEDIUM is used only when exactly one process has a matching file/directory open at I/O onset. Multiple plausible processes remain UNKNOWN/ambiguous.
>
> Current-open-file snapshots and power-state files live under `/var/local/emhttp` (RAM). Wake history is the only persistent runtime data written to the boot device.

<input type="submit" name="#default" value="_(Default)_">
: <input type="submit" name="#apply" value="_(Apply)_"><input type="button" value="_(Done)_" onclick="done()">
</form>

<script>
$(function () {
  'use strict';

  var DAP = window.DiskActivityPlus;

  function renderOpenFiles(data) {
    var files = Array.isArray(data.files) ? data.files : [];
    $('#open-file-count').text(files.length + (data.truncated ? '+' : ''));

    var counts = {};
    var rows = '';
    files.forEach(function (entry) {
      var actor = DAP.actorLabel(entry);
      counts[actor] = (counts[actor] || 0) + 1;
      rows += '<tr>' +
        '<td>' + DAP.escapeHtml(actor) + '</td>' +
        '<td>' + DAP.escapeHtml(entry.pid || '-') + '</td>' +
        '<td>' + DAP.escapeHtml(entry.disk || entry.device || '-') + '</td>' +
        '<td class="wake-path" title="' + DAP.escapeAttribute(entry.path || '') + '">' +
          DAP.escapeHtml(entry.path || '-') +
        '</td>' +
      '</tr>';
    });

    var top = Object.keys(counts).sort(function (a, b) {
      return counts[b] - counts[a];
    })[0] || '-';
    $('#open-file-source').text(top);

    if (!rows) {
      rows = '<tr><td colspan="4">No regular files are currently open on monitored HDD pools.</td></tr>';
    }
    $('#open-files-table tbody').html(rows);

    var stale = !!data.stale;
    $('#open-files-status')
      .attr('class', 'wake-status ' + (stale ? 'wake-warn' : 'wake-ok'))
      .text(stale
        ? 'Open-file snapshot is stale; check /var/log/disk_wake_monitor.log.'
        : 'Live open-file snapshot · RAM only · updated every 5s');
  }

  var poller = DAP.createPoller({
    url: '/plugins/disk.activity/include/OpenFiles.php?limit=500',
    interval: 5000,
    timeout: 3000,
    onData: renderOpenFiles,
    onError: function () {
      $('#open-files-status')
        .attr('class', 'wake-status wake-warn')
        .text('Unable to read open-file snapshot.');
    }
  });

  poller.start();
});
</script>
