<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
  <!ENTITY name      "disk.activity">
  <!ENTITY author    "atsrxL / DerekChan65535">
  <!ENTITY version   "2026.08.21.4">
  <!ENTITY launch    "Settings/DiskActivityPlus">
  <!ENTITY gitURL    "https://raw.githubusercontent.com/atsrxL/unraid_disk_activity_plus/main">
  <!ENTITY pluginURL "&gitURL;/disk.activity.plg">
  <!ENTITY txzURL    "https://github.com/atsrxL/unraid_disk_activity_plus/releases/download/v&version;/disk.activity-&version;.txz">
  <!ENTITY support   "https://github.com/atsrxL/unraid_disk_activity_plus/issues">
]>
<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;" support="&support;" min="7.3.0" max="7.9.9">
<CHANGES>
###2026.08.21.4
- Remove the legacy Main-page Activity % column and its 2-second /proc/diskstats sampler daemon
- Remove obsolete Activity display style and averaging-window settings
- Keep the plugin focused on HDD power state, wake attribution/history, and current open files
- Clean legacy Activity files and stale display/window config keys during upgrade

###2026.08.21.3
- Remove legacy DiskActivitySettings.page during upgrade so only the User Utilities entry remains
- Prevent old System Settings / Other Settings icons from surviving package upgrades

###2026.08.21.2
- Fix blank Disk Activity Plus page by using the correct Unraid xmenu tab container
- Keep a single Settings > User Utilities entry with Open Files / Settings and Wake History tabs

###2026.08.21.1
- Add native sortable Dashboard tile for currently open HDD files
- Add RAM-only /proc open-FD snapshots with process and Docker/Podman attribution
- Add Reset Wake Statistics action with Unraid CSRF protection and file locking
- Count only HIGH-confidence events toward named wake-source percentages; MEDIUM remains a visible possible source
- Make open-FD fallback conservative: exactly one matching process is required for MEDIUM, otherwise UNKNOWN/ambiguous
- Skip open-FD attribution work entirely when wake tracking is disabled
- Add bounded wake-history retention (days + maximum events) and RAM API caching
- Only map ZFS datasets that are actually mounted
- Rebuild the native wake monitor from validated source fragments with -Werror checks
- Harden release workflow: explicit version validation, immutable releases, and tag the exact build commit

###2026.08.21
- First Disk Activity Plus release based on DerekChan65535/unraid-disk-activity 2026.06.08
</CHANGES>
<FILE Run="/bin/bash" Method="install">
<INLINE><![CDATA[
PLUGIN=/usr/local/emhttp/plugins/disk.activity
if [ -x "$PLUGIN/scripts/rc.disk_activity" ]; then
  "$PLUGIN/scripts/rc.disk_activity" stop >/dev/null 2>&1 || true
fi
# Remove legacy UI/sampler files left by earlier releases or unmanaged overlays.
rm -f "$PLUGIN/DiskActivitySettings.page" \
      "$PLUGIN/DiskActivityColumn.page" \
      "$PLUGIN/include/DiskActivity.php" \
      "$PLUGIN/scripts/disk_activity" \
      "$PLUGIN/assets/disk-activity.css"
rm -f /var/local/emhttp/disk_activity.ini /var/local/emhttp/disk_activity.tmp /var/run/disk_activity.pid
]]></INLINE>
</FILE>
<FILE Name="/boot/config/plugins/&name;/&name;-&version;.txz" Run="upgradepkg --install-new --reinstall">
<URL>&txzURL;</URL>
</FILE>
<FILE Run="/bin/bash" Method="install">
<INLINE><![CDATA[
PLUGIN=/usr/local/emhttp/plugins/disk.activity
# Defensive post-upgrade cleanup for files that may not be owned by the current Slackware package.
rm -f "$PLUGIN/DiskActivitySettings.page" \
      "$PLUGIN/DiskActivityColumn.page" \
      "$PLUGIN/include/DiskActivity.php" \
      "$PLUGIN/scripts/disk_activity" \
      "$PLUGIN/assets/disk-activity.css"
rm -f /var/local/emhttp/disk_activity.ini /var/local/emhttp/disk_activity.tmp /var/run/disk_activity.pid
chmod +x "$PLUGIN/scripts/rc.disk_activity" "$PLUGIN/scripts/disk_wake_tracker" "$PLUGIN/bin/disk_wake_monitor"
chmod +x "$PLUGIN/event/started/disk_activity_start" "$PLUGIN/event/stopping_svcs/disk_activity_stop"
mkdir -p /boot/config/plugins/disk.activity
CFG=/boot/config/plugins/disk.activity/disk.activity.cfg
if [ -f "$CFG" ]; then
  sed -i '/^display=/d;/^window=/d' "$CFG"
fi
if [ -e /proc/mdcmd ] && grep -q 'mdState=.*STARTED' /var/local/emhttp/var.ini 2>/dev/null; then
  "$PLUGIN/scripts/rc.disk_activity" start >/dev/null 2>&1 || true
fi
cd /boot/config/plugins/disk.activity || exit 0
shopt -s nullglob
latest="$(printf '%s\n' disk.activity-*.txz | sort -V | tail -n 1)"
for f in disk.activity-*.txz; do
  [[ "$f" == "$latest" ]] || rm -f "$f"
done
]]></INLINE>
</FILE>
<FILE Run="/bin/bash" Method="remove">
<INLINE><![CDATA[
if [ -x /usr/local/emhttp/plugins/disk.activity/scripts/rc.disk_activity ]; then
  /usr/local/emhttp/plugins/disk.activity/scripts/rc.disk_activity stop >/dev/null 2>&1 || true
fi
for pkg in /var/log/packages/disk.activity-*; do
  [ -e "$pkg" ] || continue
  removepkg "$(basename "$pkg")" >/dev/null 2>&1 || true
done
rm -f /var/local/emhttp/disk_activity.ini /var/local/emhttp/disk_activity.tmp /var/run/disk_activity.pid
rm -f /var/local/emhttp/disk_wake_state.json /var/local/emhttp/disk_wake_devices.tsv /var/local/emhttp/disk_open_files.json /var/local/emhttp/disk_wake_history_cache.json /var/run/disk_wake_monitor.pid
rm -rf /usr/local/emhttp/plugins/disk.activity
rm -rf /boot/config/plugins/disk.activity
]]></INLINE>
</FILE>
</PLUGIN>
